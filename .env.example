# Configuração de Exemplo (Copie para .env.local e preencha suas chaves)
# ATENÇÃO: NUNCA commite suas chaves reais no repositório público!

# URL da API de Autenticação do Neon Auth
VITE_NEON_AUTH_URL=https://ep-seu-endpoint.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth

# String de Conexão com o Banco de Dados Neon (PostgreSQL Pooler)
VITE_DATABASE_URL=postgresql://usuario:senha@ep-seu-endpoint-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave da API do Google Gemini (Serverless / Backend)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
